{
  "name": "vmux",
  "displayName": "vmux — Agent-Friendly Terminal",
  "description": "AI 코딩 에이전트를 위한 터미널 확장. 알림, 세션 관리, 환경 컨텍스트 주입.",
  "version": "0.1.2",
  "publisher": "roboco-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roboco-io/vmux"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "icon": "resources/vmux-icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "vmux": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:cli && npm run build:mcp",
    "build:mcp": "node scripts/build-mcp.js",
    "build:ext": "esbuild src/extension/extension.ts --bundle --outfile=dist/extension.js --platform=node --format=cjs --external:vscode --sourcemap",
    "build:cli": "node scripts/build-cli.js",
    "watch": "concurrently \"npm run build:ext -- --watch\" \"npm run build:cli -- --watch\"",
    "lint": "eslint src/",
    "test": "node --test dist/test/**/*.test.js",
    "build:e2e": "node scripts/build-e2e.js",
    "test:e2e": "npm run build && npm run build:e2e && node dist/e2e/runTest.js",
    "package": "vsce package",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vmux",
          "title": "vmux",
          "icon": "resources/vmux-icon.svg"
        }
      ]
    },
    "views": {
      "vmux": [
        {
          "id": "vmux.notifications",
          "name": "Notifications"
        },
        {
          "id": "vmux.terminals",
          "name": "Terminals"
        },
        {
          "id": "vmux.sessions",
          "name": "Sessions"
        },
        {
          "id": "vmux.metadata",
          "name": "Metadata"
        },
        {
          "id": "vmux.tabgroups",
          "name": "Tab Groups"
        }
      ]
    },
    "commands": [
      {
        "command": "vmux.createTerminal",
        "title": "vmux: Create Terminal"
      },
      {
        "command": "vmux.saveSession",
        "title": "vmux: Save Session"
      },
      {
        "command": "vmux.restoreSession",
        "title": "vmux: Restore Session"
      },
      {
        "command": "vmux.jumpToNotification",
        "title": "vmux: Jump to Latest Notification"
      },
      {
        "command": "vmux.clearNotifications",
        "title": "vmux: Clear Notifications"
      },
      {
        "command": "vmux.launchAgentGrid",
        "title": "vmux: Launch Agent Grid"
      },
      {
        "command": "vmux.createTabGroup",
        "title": "vmux: Create Tab Group"
      },
      {
        "command": "vmux.deleteTabGroup",
        "title": "Delete Tab Group"
      },
      {
        "command": "vmux.renameTabGroup",
        "title": "Rename Tab Group"
      },
      {
        "command": "vmux.addTerminalToTabGroup",
        "title": "vmux: Add Terminal to Tab Group"
      },
      {
        "command": "vmux.removeTerminalFromTabGroup",
        "title": "Remove from Tab Group"
      },
      {
        "command": "vmux.broadcastToTabGroup",
        "title": "Broadcast to Tab Group"
      },
      {
        "command": "vmux.focusTabGroup",
        "title": "Focus Tab Group"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vmux.deleteTabGroup",
          "when": "viewItem == tabgroup",
          "group": "inline"
        },
        {
          "command": "vmux.renameTabGroup",
          "when": "viewItem == tabgroup"
        },
        {
          "command": "vmux.broadcastToTabGroup",
          "when": "viewItem == tabgroup"
        },
        {
          "command": "vmux.focusTabGroup",
          "when": "viewItem == tabgroup"
        },
        {
          "command": "vmux.removeTerminalFromTabGroup",
          "when": "viewItem == tabgroup-terminal"
        },
        {
          "command": "vmux.deleteSession",
          "when": "viewItem == session",
          "group": "inline"
        },
        {
          "command": "vmux.restoreSessionFromTree",
          "when": "viewItem == session"
        }
      ],
      "view/title": [
        {
          "command": "vmux.createTabGroup",
          "when": "view == vmux.tabgroups",
          "group": "navigation"
        },
        {
          "command": "vmux.addTerminalToTabGroup",
          "when": "view == vmux.tabgroups"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vmux.jumpToNotification",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "vmux.createTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.defaultLocation": "editor",
      "terminal.integrated.confirmOnKill": "hasChildProcesses",
      "terminal.integrated.confirmOnExit": "hasChildProcesses",
      "terminal.integrated.tabs.title": "${process}",
      "terminal.integrated.tabs.description": "${cwdFolder}"
    },
    "configuration": {
      "title": "vmux",
      "properties": {
        "vmux.ipc.type": {
          "type": "string",
          "enum": [
            "unix",
            "http"
          ],
          "default": "unix",
          "description": "IPC transport type (unix socket or HTTP)"
        },
        "vmux.ipc.port": {
          "type": "number",
          "default": 0,
          "description": "HTTP port (0 = auto-assign)"
        },
        "vmux.autoRestore": {
          "type": "boolean",
          "default": false,
          "description": "Restore last terminal session on workspace open"
        },
        "vmux.systemNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code notification popups for agent notifications"
        },
        "vmux.envPrefix": {
          "type": "string",
          "default": "VMUX",
          "description": "Environment variable prefix for terminal injection"
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.3.6"
  }
}
