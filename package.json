{
  "name": "vmux",
  "displayName": "vmux — Agent-Friendly Terminal",
  "description": "AI 코딩 에이전트를 위한 터미널 확장. 알림, 세션 관리, 환경 컨텍스트 주입.",
  "version": "0.1.0",
  "publisher": "roboco-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roboco-io/tools"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "bin": {
    "vmux": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:cli",
    "build:ext": "esbuild src/extension/extension.ts --bundle --outfile=dist/extension.js --platform=node --format=cjs --external:vscode --sourcemap",
    "build:cli": "node scripts/build-cli.js",
    "watch": "concurrently \"npm run build:ext -- --watch\" \"npm run build:cli -- --watch\"",
    "lint": "eslint src/",
    "test": "node --test dist/test/**/*.test.js",
    "build:e2e": "node scripts/build-e2e.js",
    "test:e2e": "npm run build && npm run build:e2e && node dist/e2e/runTest.js",
    "package": "vsce package",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "concurrently": "^9.0.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vmux",
          "title": "vmux",
          "icon": "resources/vmux-icon.svg"
        }
      ]
    },
    "views": {
      "vmux": [
        { "id": "vmux.notifications", "name": "Notifications" },
        { "id": "vmux.terminals", "name": "Terminals" },
        { "id": "vmux.sessions", "name": "Sessions" },
        { "id": "vmux.metadata", "name": "Metadata" }
      ]
    },
    "commands": [
      { "command": "vmux.createTerminal", "title": "vmux: Create Terminal" },
      { "command": "vmux.saveSession", "title": "vmux: Save Session" },
      { "command": "vmux.restoreSession", "title": "vmux: Restore Session" },
      { "command": "vmux.jumpToNotification", "title": "vmux: Jump to Latest Notification" },
      { "command": "vmux.clearNotifications", "title": "vmux: Clear Notifications" }
    ],
    "keybindings": [
      {
        "command": "vmux.jumpToNotification",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      }
    ],
    "configuration": {
      "title": "vmux",
      "properties": {
        "vmux.ipc.type": {
          "type": "string",
          "enum": ["unix", "http"],
          "default": "unix",
          "description": "IPC transport type (unix socket or HTTP)"
        },
        "vmux.ipc.port": {
          "type": "number",
          "default": 0,
          "description": "HTTP port (0 = auto-assign)"
        },
        "vmux.autoRestore": {
          "type": "boolean",
          "default": false,
          "description": "Restore last terminal session on workspace open"
        },
        "vmux.systemNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code notification popups for agent notifications"
        },
        "vmux.envPrefix": {
          "type": "string",
          "default": "VMUX",
          "description": "Environment variable prefix for terminal injection"
        }
      }
    }
  }
}
