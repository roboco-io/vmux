        <mxCell id="metadata-view" value="Metadata&#xa;Panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#3461B3;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="65" y="143" width="150" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="terminals-view" value="Terminals&#xa;TreeView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#3461B3;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="65" y="201" width="150" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="sessions-view" value="Sessions&#xa;TreeView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#3461B3;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="65" y="259" width="150" height="48" as="geometry"/>
        </mxCell>

        <!-- StatusBar -->
        <mxCell id="statusbar" value="StatusBar&#xa;(Notification Badge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BF8F00;strokeColor=#A67C00;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="65" y="340" width="150" height="38" as="geometry"/>
