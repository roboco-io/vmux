        <mxCell id="term1" value="Terminal 1&#xa;(Claude Code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#44722A;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="295" y="87" width="153" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="term2" value="Terminal 2&#xa;(Codex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#44722A;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="463" y="87" width="153" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="term3" value="Terminal 3&#xa;(Shell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#44722A;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="295" y="180" width="153" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="term4" value="Terminal 4&#xa;(Build)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#44722A;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="463" y="180" width="153" height="55" as="geometry"/>
        </mxCell>

        <!-- Shell Integration -->
        <mxCell id="shell-int" value="Shell Integration API&#xa;(executeCommand + read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BF8F00;strokeColor=#A67C00;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="680" y="87" width="210" height="55" as="geometry"/>
        </mxCell>

        <!-- Env Vars -->
        <mxCell id="env-vars" value="Env Context&#xa;VMUX_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BF8F00;strokeColor=#A67C00;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="680" y="180" width="210" height="55" as="geometry"/>
        </mxCell>

        <!-- Extension Host -->
        <mxCell id="ext-host-box" value="Extension Host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7B57A0;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#7B57A0;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="960" height="180" as="geometry"/>
        </mxCell>

        <!-- Manager row -->
        <mxCell id="notif-mgr" value="Notification&#xa;Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B57A0;strokeColor=#6A4890;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="85" y="425" width="145" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="session-mgr" value="Session&#xa;Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B57A0;strokeColor=#6A4890;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="340" y="425" width="145" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="terminal-mgr" value="Terminal&#xa;Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B57A0;strokeColor=#6A4890;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="595" y="425" width="145" height="60" as="geometry"/>
        </mxCell>

        <!-- IPC Server -->
        <mxCell id="ipc-server" value="IPC Server&#xa;(Unix Socket + HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B57A0;strokeColor=#6A4890;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="350" y="510" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== External Components ==================== -->

        <!-- CLI Tool -->
        <mxCell id="cli-tool" value="CLI Tool&#xa;(vmux)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#A94442;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="130" y="640" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- MCP Server -->
        <mxCell id="mcp-server" value="MCP Server&#xa;(optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#A94442;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="500" y="640" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- Agent Hooks -->
        <mxCell id="agent-hooks" value="Agent Hooks&#xa;(Claude, Codex,&#xa;Gemini CLI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#606060;strokeColor=#505050;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="130" y="740" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- AI Agent -->
        <mxCell id="ai-agent" value="AI Agent&#xa;(MCP Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#606060;strokeColor=#505050;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="500" y="740" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- ==================== Edges ==================== -->

        <!-- e1: CLI Tool → IPC Server (JSON-RPC) -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C0504D;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" source="cli-tool" target="ipc-server" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1-label" value="JSON-RPC" style="edgeLabel;html=1;fontSize=10;fontColor=#C0504D;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="0.3" relative="1" as="geometry"/>
        </mxCell>

        <!-- e2: MCP Server → IPC Server (JSON-RPC) -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C0504D;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" source="mcp-server" target="ipc-server" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2-label" value="JSON-RPC" style="edgeLabel;html=1;fontSize=10;fontColor=#C0504D;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="0.3" relative="1" as="geometry"/>
        </mxCell>

        <!-- e3: Agent Hooks → CLI Tool (exec) -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#808080;strokeWidth=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="agent-hooks" target="cli-tool" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3-label" value="exec" style="edgeLabel;html=1;fontSize=10;fontColor=#808080;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e4: AI Agent → MCP Server (MCP tool call) -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#808080;strokeWidth=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="ai-agent" target="mcp-server" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4-label" value="MCP tool call" style="edgeLabel;html=1;fontSize=10;fontColor=#808080;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e5: IPC Server → Notification Manager -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7B57A0;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" source="ipc-server" target="notif-mgr" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e6: IPC Server → Session Manager -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7B57A0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="ipc-server" target="session-mgr" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e7: IPC Server → Terminal Manager -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7B57A0;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" source="ipc-server" target="terminal-mgr" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e8: Notification Manager → Notifications TreeView -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#4472C4;exitX=0.35;exitY=0;entryX=0.6;entryY=1;" edge="1" source="notif-mgr" target="notify-view" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e9: Notification Manager → StatusBar -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#BF8F00;exitX=0.7;exitY=0;entryX=0.6;entryY=1;" edge="1" source="notif-mgr" target="statusbar" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e10: Terminal Manager → Term4 -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#548235;exitX=0.3;exitY=0;entryX=0.8;entryY=1;" edge="1" source="terminal-mgr" target="term4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- e11: Shell Integration → Term2 -->
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#BF8F00;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="shell-int" target="term2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
