        <mxCell id="notify-view" value="Notifications&#xa;TreeView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#3461B3;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1">
