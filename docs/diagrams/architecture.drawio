        <!-- Sidebar (Activity Bar) -->
        <mxCell id="sidebar-box" value="Sidebar (Activity Bar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6AAF6A;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#6AAF6A;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="55" width="180" height="270" as="geometry"/>
